@page
@model ContactModel
@{
	ViewData["Title"] = "Contact page";
}

<div class="form">
	<h1>Contact Form</h1>
	<br>
    <form method="POST">
		<label for="name">Name:</label><br>
		<input type="text" id="name" asp-for="Contact.Name">
		<br>
		<span asp-validation-for="Contact.Name"></span>
		<br>
		<label for="email">Email:</label><br>
		<input type="email" id="email" asp-for="Contact.Email">
		<br>
		<span asp-validation-for="Contact.Email"></span>
		<br>
		<label for="message">Message:</label><br>
		<textarea id="message" asp-for="Contact.Message" rows="4" cols="50"
			placeholder="Write your message here!"></textarea>
		<br>
		<span asp-validation-for="Contact.Message"></span>
		<br>
		<input type="submit" value="Submit">
		<br>
	</form>
</div>